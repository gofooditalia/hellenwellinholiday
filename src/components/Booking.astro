---
import { t } from '../i18n/index';
import type { Lang } from '../i18n/index';
import ContactForm from './ContactForm.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const tr = t(lang);

const AIRBNB_URL = 'https://www.airbnb.it/rooms/1197900619513309871';

const stats = [tr.booking.guests, tr.booking.bedrooms, tr.booking.beds, tr.booking.bathrooms, tr.booking.parking];

const spaces = [
  { name: tr.booking.spaces.room1Name, desc: tr.booking.spaces.room1Desc },
  { name: tr.booking.spaces.room2Name, desc: tr.booking.spaces.room2Desc },
];
---

<section id="prenota" class="py-20 lg:py-28 bg-sky-900 text-white">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section header -->
    <div class="text-center mb-14">
      <h2 class="font-display text-4xl lg:text-5xl font-bold mb-4">
        {tr.booking.title}
      </h2>
      <p class="text-lg text-sky-200 max-w-2xl mx-auto">
        {tr.booking.subtitle}
      </p>
      <div class="mt-5 w-14 h-0.5 bg-amber-400 mx-auto"></div>
    </div>

    <!-- Overview card -->
    <div class="rounded-2xl bg-white text-slate-800 p-7 lg:p-9 mb-6">
      <span class="text-xs font-semibold tracking-widest uppercase text-sky-600">{tr.booking.overviewLabel}</span>

      <div class="flex flex-wrap gap-x-6 gap-y-2 mt-4 mb-7">
        {stats.map((s) => (
          <span class="flex items-center gap-2 text-sm text-slate-600">
            <svg class="w-4 h-4 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            {s}
          </span>
        ))}
      </div>

      <a
        href={AIRBNB_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-center gap-2 bg-amber-400 hover:bg-amber-500 text-slate-900 font-semibold text-sm px-5 py-3 rounded-full transition-all duration-200 hover:scale-105 shadow-md w-full sm:w-auto"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm.75 17.5c-.414 0-.75-.336-.75-.75v-5h-1.5c-.414 0-.75-.336-.75-.75s.336-.75.75-.75H12V8.75c0-.414.336-.75.75-.75s.75.336.75.75V10.25h1.5c.414 0 .75.336.75.75s-.336.75-.75.75h-1.5v5c0 .414-.336.75-.75.75zm0-10.5c-.552 0-1-.448-1-1s.448-1 1-1 1 .448 1 1-.448 1-1 1z"/>
        </svg>
        {tr.booking.bookOnAirbnb}
      </a>
    </div>

    <!-- Spaces -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-12">
      {spaces.map((room) => (
        <div class="rounded-2xl bg-sky-800/50 border border-sky-700 p-7 flex flex-col">
          <div class="w-12 h-12 rounded-xl bg-sky-700/50 flex items-center justify-center mb-5">
            <svg class="w-6 h-6 text-sky-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
            </svg>
          </div>
          <h3 class="font-display font-bold text-xl mb-2 text-white">{room.name}</h3>
          <p class="text-sm text-sky-300">{room.desc}</p>
        </div>
      ))}
    </div>

    <!-- Contact form -->
    <div class="border-t border-sky-800 pt-12">
      <div class="text-center mb-8">
        <h3 class="font-display font-bold text-2xl text-white mb-2">
          {lang === 'it' ? 'Scrivi una richiesta' : 'Send a request'}
        </h3>
        <p class="text-sky-300 text-sm">
          {lang === 'it'
            ? 'Indica le date e riceverai una conferma con il prezzo scontato.'
            : 'Include your dates and we\'ll reply with the discounted rate.'}
        </p>
      </div>
      <ContactForm lang={lang} />
    </div>
  </div>
</section>
