---
import { t } from '../i18n/index';
import type { Lang } from '../i18n/index';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const tr = t(lang);

const GOOGLE_URL = 'https://www.google.com/maps/place/You+are+Welcome/@37.4867494,13.9885135,17z/data=!3m1!4b1!4m6!3m5!1s0x1310c17ac6153bfd:0xc17835fccd4b763c!8m2!3d37.4867494!4d13.9885135';
const AIRBNB_URL = 'https://www.airbnb.it/rooms/1197900619513309871/reviews';

const reviews = [
  {
    source: 'Google',
    name: 'Mina Edward',
    meta: lang === 'it' ? 'Local Guide · 16 recensioni · 3 mesi fa' : 'Local Guide · 16 reviews · 3 months ago',
    text: 'An amazing place to stay, right in the heart of San Cataldo. Cleanliness 10/10. Hospitality 10/10…',
  },
  {
    source: 'Google',
    name: 'Silvia Naro',
    meta: lang === 'it' ? '1 recensione · 10 mesi fa' : '1 review · 10 months ago',
    text: 'Casa deliziosa, soprattutto la camera da letto che è molto luminosa e ben arredata. Zona molto tranquilla e vicina a tutti i servizi che offre la città di San Cataldo… host gentilissima e disponibile!! Consigliatissimo 5/5',
  },
  {
    source: 'Google',
    name: 'Silvia Mammano',
    meta: lang === 'it' ? '1 recensione · 10 mesi fa' : '1 review · 10 months ago',
    text: 'Luogo accogliente, padrona di casa davvero molto gentile e disponibile!!',
  },
  {
    source: 'Airbnb',
    name: 'Violaine',
    meta: lang === 'it' ? '10 anni su Airbnb · agosto 2024' : '10 years on Airbnb · August 2024',
    text:
      lang === 'it'
        ? "Un'accoglienza premurosa da parte di Elena che sempre reattiva ai messaggi e forza di proposte per gli indirizzi nelle vicinanze. Lo consiglio!"
        : 'A caring welcome from Elena, always quick to reply to messages and full of suggestions for nearby places. I recommend it!',
  },
  {
    source: 'Airbnb',
    name: 'Joulia',
    meta: lang === 'it' ? '7 anni su Airbnb · luglio 2024' : '7 years on Airbnb · July 2024',
    text:
      lang === 'it'
        ? 'Alloggio super carino, ci tornerei volentieri. La comunicazione con Elena è stata impeccabile, ci siamo sentiti molto ben accolti. Grazie Dan.'
        : "Super cute place, I'd happily come back. Communication with Elena was flawless, we felt very welcomed. Thanks, Dan.",
  },
  {
    source: 'Airbnb',
    name: 'Nandi',
    meta: lang === 'it' ? '2 anni su Airbnb · ottobre 2024' : '2 years on Airbnb · October 2024',
    text: 'TNX Elena :)',
  },
];
---

<section id="recensioni" class="py-20 lg:py-28 bg-sky-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section header -->
    <div class="text-center mb-14">
      <h2 class="font-display text-4xl lg:text-5xl font-bold text-slate-800 mb-4">
        {tr.reviews.title}
      </h2>
      <p class="text-lg text-slate-500 max-w-xl mx-auto">
        {tr.reviews.subtitle}
      </p>
      <div class="mt-5 w-14 h-0.5 bg-amber-400 mx-auto"></div>
    </div>

    <!-- Review cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
      {reviews.map((r) => (
        <div class="rounded-2xl border border-slate-100 bg-white shadow-md p-7 flex flex-col">
          <div class="flex items-center justify-between mb-4">
            <div class="flex gap-0.5">
              {Array.from({ length: 5 }).map(() => (
                <svg class="w-4 h-4 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>
            <span class={[
              'text-[0.6875rem] font-semibold tracking-widest uppercase px-2 py-0.5 rounded-full',
              r.source === 'Airbnb' ? 'bg-rose-50 text-rose-500' : 'bg-sky-50 text-sky-600',
            ].join(' ')}>
              {r.source}
            </span>
          </div>
          <p class="text-slate-600 text-sm leading-relaxed flex-1 mb-6">"{r.text}"</p>
          <div>
            <p class="font-display font-bold text-slate-800">{r.name}</p>
            <p class="text-xs text-slate-400">{r.meta}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- CTAs -->
    <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3">
      <a
        href={GOOGLE_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-sky-600 hover:text-sky-700 font-semibold transition-colors"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
        {tr.reviews.ctaGoogle}
      </a>
      <a
        href={AIRBNB_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-rose-500 hover:text-rose-600 font-semibold transition-colors"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
        {tr.reviews.ctaAirbnb}
      </a>
    </div>
  </div>
</section>
